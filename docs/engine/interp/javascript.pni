MODULE PANINI.Frontend.JavaScript
FUNCTION jLex(source)
    tokens = []
    i = 0
    n = LEN(source)
    WHILE i < n
        ch = source[i]
        IF ch == " " OR ch == TAB() OR ch == NEWLINE() OR ch == CR()
            i = i + 1
        ELSE
            APPEND(tokens, {kind: "CH", value: ch})
            i = i + 1
        END
    END
    RETURN tokens
END
FUNCTION run_javascript(source)
    tokens = jLex(source)
    lowered = JSLOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.JavaScript"
    r.js_tokens = LEN(tokens)
    r.lowered = lowered
    RETURN r
END
FUNCTION main()
    r = run_javascript("function main(){ return 0; }")
    RETURN r.value
END
END
