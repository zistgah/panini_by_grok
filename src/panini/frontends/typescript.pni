MODULE PANINI.Frontend.TypeScript

FUNCTION tIsDigit(ch)
    RETURN ch >= "0" AND ch <= "9"
END

FUNCTION tIsAlpha(ch)
    RETURN (ch >= "A" AND ch <= "Z") OR (ch >= "a" AND ch <= "z") OR ch == "_"
END

FUNCTION tTok(kind, value)
    RETURN {kind: kind, value: value}
END

FUNCTION tLex(source)
    tokens = []
    i = 0
    n = LEN(source)
    WHILE i < n
        ch = source[i]
        IF ch == " " OR ch == TAB() OR ch == NEWLINE() OR ch == CR()
            i = i + 1
        ELSE
            IF ch == "/" AND i + 1 < n AND source[i + 1] == "/"
                WHILE i < n AND source[i] != NEWLINE()
                    i = i + 1
                END
            ELSE
                IF tIsDigit(ch)
                    raw = ""
                    WHILE i < n AND tIsDigit(source[i])
                        raw = raw + source[i]
                        i = i + 1
                    END
                    APPEND(tokens, tTok("NUM", raw))
                ELSE
                    IF tIsAlpha(ch)
                        raw = ""
                        WHILE i < n AND (tIsAlpha(source[i]) OR tIsDigit(source[i]))
                            raw = raw + source[i]
                            i = i + 1
                        END
                        kind = "IDENT"
                        IF raw == "function" OR raw == "const" OR raw == "let" OR raw == "return" OR raw == "console" OR raw == "log"
                            kind = "KW"
                        END
                        APPEND(tokens, tTok(kind, raw))
                    ELSE
                        APPEND(tokens, tTok("OP", ch))
                        i = i + 1
                    END
                END
            END
        END
    END
    APPEND(tokens, tTok("EOF", ""))
    RETURN tokens
END

FUNCTION tNew(tokens)
    RETURN {tokens: tokens, i: 0}
END

FUNCTION tPeek(st)
    IF st.i >= LEN(st.tokens)
        RETURN tTok("EOF", "")
    END
    RETURN st.tokens[st.i]
END

FUNCTION tEat(st)
    t = tPeek(st)
    st.i = st.i + 1
    RETURN t
END

FUNCTION tParseAtom(st)
    t = tPeek(st)
    IF t.kind == "NUM"
        tEat(st)
        RETURN {op: "const", value: INT(t.value)}
    END
    IF t.value == "("
        tEat(st)
        e = tParseExpr(st)
        IF tPeek(st).value == ")"
            tEat(st)
        END
        RETURN e
    END
    tEat(st)
    RETURN {op: "const", value: 0}
END

FUNCTION tParseMul(st)
    left = tParseAtom(st)
    WHILE tPeek(st).value == "*" OR tPeek(st).value == "/"
        op = tEat(st).value
        left = {op: "bin", operator: op, left: left, right: tParseAtom(st)}
    END
    RETURN left
END

FUNCTION tParseExpr(st)
    left = tParseMul(st)
    WHILE tPeek(st).value == "+" OR tPeek(st).value == "-"
        op = tEat(st).value
        left = {op: "bin", operator: op, left: left, right: tParseMul(st)}
    END
    RETURN left
END

FUNCTION tEval(e)
    IF e.op == "const"
        RETURN e.value
    END
    IF e.op == "bin"
        l = tEval(e.left)
        r = tEval(e.right)
        IF e.operator == "+"
            RETURN l + r
        END
        IF e.operator == "-"
            RETURN l - r
        END
        IF e.operator == "*"
            RETURN l * r
        END
        RETURN l / r
    END
    RETURN 0
END

FUNCTION run_typescript(source)
    tokens = tLex(source)
    st = tNew(tokens)
    value = 0
    WHILE tPeek(st).kind != "EOF"
        t = tPeek(st)
        IF t.kind == "KW" AND t.value == "log"
            tEat(st)
            IF tPeek(st).value == "("
                tEat(st)
            END
            value = tEval(tParseExpr(st))
            PRINT value
        ELSE
            tEat(st)
        END
    END
    RETURN {ok: TRUE, value: value, token_count: LEN(tokens), frontend: "PANINI.Frontend.TypeScript"}
END

FUNCTION main()
    r = run_typescript("console.log(40+2);")
    RETURN r.value
END

END
