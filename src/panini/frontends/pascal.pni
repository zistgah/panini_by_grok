MODULE PANINI.Frontend.Pascal
FUNCTION run_pascal(source)
    lowered = PASCALLOWER(source)
    r = run_c(lowered)
    r.frontend = "PANINI.Frontend.Pascal"
    r.lowered = lowered
    RETURN r
END
FUNCTION main()
    r = run_pascal("function main: integer; begin main := 0 end.")
    RETURN r.value
END
END
